# ============================================================================
# TALON Quantitative Worker — Environment Configuration Template
# ============================================================================
# Copy this file to .env for local overrides. NEVER commit .env to version control.
# By default, TALON runs strictly in PAPER / SIMULATION mode.

# Execution mode: "paper" (default, safe) or "live" (locked behind dual safety gates)
TALON_MODE=paper

# Dual safety gate for live execution:
# To unlock live order routing, you MUST set:
#   1. TALON_MODE=live
#   2. TALON_LIVE_TRADING=I-ACCEPT-REAL-MONEY-RISK
#   3. Provide a dedicated configs/live.yaml file with explicit risk limits
TALON_LIVE_TRADING=

# Optional config path override
TALON_CONFIG_PATH=configs/default.yaml

# Logging level: DEBUG, INFO, WARNING, ERROR
TALON_LOG_LEVEL=INFO

# Optional exchange credentials (ONLY read if live mode is explicitly unlocked; never logged)
TALON_EXCHANGE_API_KEY=
TALON_EXCHANGE_API_SECRET=
TALON_EXCHANGE_PASSPHRASE=
